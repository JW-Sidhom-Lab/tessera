# =============================================================================
# TESSERA .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Reference genomes (downloaded by users via download_ref_genomes.sh; too large
# for git — ~3 GB each). The .fai indexes are small (~10 KB) and may be useful
# to ship; uncomment the .fai lines below if you ever want to gitignore them too.
# -----------------------------------------------------------------------------
*.fna
*.fna.gz
# *.fna.fai

# -----------------------------------------------------------------------------
# Model weights (hosted on Hugging Face Hub; not redistributed via git)
# -----------------------------------------------------------------------------
*.h5
*.keras
*.ckpt
*.pb
*.pt
*.pth
*.safetensors
saved_model/
checkpoints/
models/

# -----------------------------------------------------------------------------
# Training logs / TensorBoard / experiment artefacts
# -----------------------------------------------------------------------------
logs/
tb_logs/
runs/
events.out.tfevents.*
*.tfevents.*
*.log
wandb/
mlruns/

# -----------------------------------------------------------------------------
# Local data (cohort outputs, intermediate features, predictions)
# -----------------------------------------------------------------------------
data/cache/
data/processed/
data/raw/
*.npy
*.npz
*.parquet
features/
multimodal_features/

# Per-script artefact directories (cached features, losses, plots, embeddings).
# These contain the outputs of running the orchestration scripts under scripts/X
# and are gitignored by directory name. They typically hold .pkl, .h5, .pdf, .png
# or other large cached artefacts that should never enter the public repo.
scripts/*/var_features/
scripts/*/var_loss/
scripts/*/plots/
scripts/*/models/
scripts/*/models_old/
scripts/*/multimodal_features/
scripts/*/multimodal_loss/
scripts/*/embeddings/
# Local-only migration utility for loading the previous pkg.var_llm
# .keras checkpoints; not part of the public API.
tessera/_legacy.py
scripts/*/features/
scripts/*/predictions/
scripts/*/results/
scripts/*/runs/
scripts/*/cna_features/
scripts/*/cna_loss/
scripts/*/cna_loss_panel_filtered/
scripts/*/var_attn/
scripts/*/models_macro/
scripts/prognostic_bm/analysis_results_*/
# variant_effect outputs: dedup-split data + per-model ClinVar predictions.
# Both regenerated by re-running create_variant_dedup_split.py /
# generate_clinvar_predictions.py.
scripts/variant_effect/data/
scripts/variant_effect/clinvar_preds_dedup_*/

# Per-cohort raw and derived data files under data/<cohort>/. Users download
# the raw data from the original sources documented in each cohort's scripts
# (e.g. GDC PanCanAtlas for TCGA) and regenerate the derived CSVs by running
# the create_training_data*.py scripts. The .py scripts themselves stay tracked.
# Deep-glob (data/**/*.ext) so subdirectories like
# data/DepMap/CTRPv2.0_2015_ctd2_ExpandedDataset/ also get caught.
data/**/*.maf
data/**/*.maf.gz
data/**/*.txt
data/**/*.tsv
data/**/*.csv
data/**/*.seg
data/**/*.vcf
data/**/*.vcf.gz
data/**/*.pkl
data/**/*.xlsx
data/**/*.xls

# Small curated reference files under data/<cohort>/ that are
# manuscript-essential and small enough to track. Exceptions to the
# data/**/*.{csv,tsv,Rds,...} blocks above. Each prognostic cohort
# directory ships its build script, the small published source tables
# it consumes, and the resulting <cohort>_clinical_metadata.csv that
# scripts/ analyses read.
!data/prognostic/glioma/Matrix_WHO2021.csv
!data/prognostic/glioma/glioma_clinical_metadata.csv
!data/prognostic/brca/DLRS_tcga_brca_complete.csv
!data/prognostic/brca/brca_clinical_metadata.csv
!data/prognostic/prad/curatedPCaData_tcga_scores_20230215.Rds
!data/prognostic/prad/prad_clinical_metadata.csv

# Large model-ready train/valid CSVs from the second-stage data prep under
# scripts/data/<cohort>/. Each is 30-150 MB and is regenerated by running
# the create_training_*.py scripts in that cohort's directory. Small reference
# files like train_test_patients_reference.csv stay tracked for reproducibility.
scripts/data/*/train_data_*.csv
scripts/data/*/valid_data_*.csv

# Per-cohort SNV / CNA model-ready tables for validation cohorts that don't
# split into train/valid (e.g. GENIE, MSK-CHORD). Outputs of each cohort's
# create_snv.py / create_cna.py scripts; regenerated by running them.
# Note: small panel-filtered DepMap files (snv_panel.csv, cna_panel.csv,
# metadata.csv) under scripts/data/depmap/ are intentionally tracked since
# they are the manuscript-essential inputs for the Figure 6n cell-line
# validation, and the upstream prepare_depmap_data.py is not shipped.
scripts/data/*/snv.csv
scripts/data/*/cna.csv
scripts/data/*/cna_panel_filtered.csv

# Inference-time caches lazily produced by downstream scripts from the train/
# valid CSVs above. Regenerated automatically the first time a consumer runs.
scripts/data/*/cna_stats.json

